STNC_institutions.5002.desc.energy_cost:	"    §R+[FromFrom.temp_energy_cost]§! £energy£ §HEnergy§!\n"
STNC_institutions.5002.desc.food_cost:	"    §R+[FromFrom.temp_food_cost]§! £food£ §HFood§!\n"
