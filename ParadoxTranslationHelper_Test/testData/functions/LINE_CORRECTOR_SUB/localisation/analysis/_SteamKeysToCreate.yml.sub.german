living_standard_psi_assimilation_name:	"Die Jagd"
living_standard_psi_assimilation_tooltip_delayed:	"|___CC012619___|Die Jagd ist alles.|___CC012620___|"
living_standard_psi_assimilation_tooltip:	"Unsere Bevölkerung konzentriert sich auf die Jagd nach Trophäen, auf Kosten fast aller anderen Dinge."
living_standard_psi_assimilation:	"Die Jagd"
living_standard_subsistence_name:	"Grundlegende Lebenshaltung"
